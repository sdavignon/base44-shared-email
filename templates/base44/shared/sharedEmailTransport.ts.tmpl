import { createClientFromRequest } from "npm:@base44/sdk";
import { SHARED_EMAIL, splitAddresses } from "./sharedEmailConfig.ts";

type MailInput = {
  from: string;
  fromName?: string;
  replyTo?: string;
  to: string[];
  cc?: string[];
  bcc?: string[];
  subject: string;
  text?: string;
  html?: string;
};

const json = async (response: Response) => {
  const body = await response.text();
  try { return body ? JSON.parse(body) : {}; } catch { return { body }; }
};

export async function getSharedEmailSettings(base44: any) {
  const rows = await base44.asServiceRole.entities.SharedEmailSettings.filter({ key: "default" });
  return rows[0] || { key: "default", provider: "sendgrid", from_name: SHARED_EMAIL.brandName, polling_enabled: true };
}

export async function deliverSharedEmail(mail: MailInput, settings: any) {
  const provider = settings.provider || "sendgrid";
  if (provider === "resend") {
    const apiKey = Deno.env.get("RESEND_API_KEY");
    if (!apiKey) throw new Error("RESEND_API_KEY is not configured");
    const response = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: { Authorization: "Bearer " + apiKey, "Content-Type": "application/json" },
      body: JSON.stringify({
        from: mail.fromName ? mail.fromName + " <" + mail.from + ">" : mail.from,
        to: mail.to,
        cc: mail.cc?.length ? mail.cc : undefined,
        bcc: mail.bcc?.length ? mail.bcc : undefined,
        reply_to: mail.replyTo || undefined,
        subject: mail.subject,
        text: mail.text || undefined,
        html: mail.html || undefined,
      }),
    });
    const data = await json(response);
    if (!response.ok) throw new Error("Resend rejected the message: " + JSON.stringify(data));
    return { provider, providerMessageId: data.id || "", response: data };
  }

  const apiKey = Deno.env.get("SENDGRID_API_KEY");
  if (!apiKey) throw new Error("SENDGRID_API_KEY is not configured");
  const response = await fetch("https://api.sendgrid.com/v3/mail/send", {
    method: "POST",
    headers: { Authorization: "Bearer " + apiKey, "Content-Type": "application/json" },
    body: JSON.stringify({
      personalizations: [{
        to: mail.to.map((email) => ({ email })),
        cc: mail.cc?.map((email) => ({ email })),
        bcc: mail.bcc?.map((email) => ({ email })),
      }],
      from: { email: mail.from, name: mail.fromName || settings.from_name || SHARED_EMAIL.brandName },
      reply_to: mail.replyTo || settings.reply_to ? { email: mail.replyTo || settings.reply_to } : undefined,
      subject: mail.subject,
      content: [
        ...(mail.text ? [{ type: "text/plain", value: mail.text }] : []),
        ...(mail.html ? [{ type: "text/html", value: mail.html }] : []),
      ],
    }),
  });
  const data = await json(response);
  if (!response.ok) throw new Error("SendGrid rejected the message: " + JSON.stringify(data));
  return { provider, providerMessageId: response.headers.get("x-message-id") || "", response: data };
}

export { createClientFromRequest, splitAddresses };
