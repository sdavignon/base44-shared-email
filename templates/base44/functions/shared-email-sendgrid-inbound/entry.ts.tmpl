import { createClientFromRequest } from "npm:@base44/sdk";
import { normalizeEmail, splitAddresses } from "../../shared/sharedEmailConfig.ts";
import { verifySendGridWebhook } from "../../shared/sharedEmailWebhook.js";
import { verifyInboundParseSecret } from "../../shared/sharedEmailInboundAuth.js";

const header = (headers: string, name: string) => {
  const match = headers.match(new RegExp("^" + name + ":\\s*(.+)$", "im"));
  return match?.[1]?.trim() || "";
};

Deno.serve(async (request) => {
  if (request.method !== "POST") return Response.json({ error: "POST required" }, { status: 405 });
  const hasSignature = Boolean(request.headers.get("x-twilio-email-event-webhook-signature"));
  const authenticated = verifyInboundParseSecret(request, Deno.env.get("SENDGRID_INBOUND_PARSE_SECRET"))
    || (hasSignature && await verifySendGridWebhook(request, "SENDGRID_INBOUND_WEBHOOK_PUBLIC_KEY"));
  if (!authenticated) return Response.json({ error: "Inbound webhook authentication failed" }, { status: 401 });
  try {
    const base44 = createClientFromRequest(request);
    const form = await request.formData();
    const envelope = JSON.parse(String(form.get("envelope") || "{}"));
    const headers = String(form.get("headers") || "");
    const providerMessageId = header(headers, "Message-ID").replace(/[<>]/g, "");
    const from = normalizeEmail(envelope.from || form.get("from"));
    const recipients = splitAddresses(envelope.to || form.get("to"));
    const aliases = await base44.asServiceRole.entities.SharedEmailAlias.filter({ enabled: true });
    const alias = aliases.find((item: any) => recipients.includes(normalizeEmail(item.address)));
    if (!alias) return Response.json({ accepted: true, ignored: "No enabled mailbox matched" }, { status: 202 });
    if (providerMessageId) {
      const existing = await base44.asServiceRole.entities.SharedEmailMessage.filter({ provider_message_id: providerMessageId, alias_id: alias.id });
      if (existing[0]) return Response.json({ accepted: true, duplicate: true });
    }

    const subject = String(form.get("subject") || "(no subject)").trim();
    const textBody = String(form.get("text") || "");
    const htmlBody = String(form.get("html") || "");
    const receivedAt = new Date().toISOString();
    const attachmentCount = Number(form.get("attachments") || 0);
    if (!Number.isInteger(attachmentCount) || attachmentCount < 0 || attachmentCount > 100) throw new Error("Invalid attachment count");
    const attachments = [];
    for (let index = 1; index <= attachmentCount; index += 1) {
      const file = form.get("attachment" + index);
      if (!(file instanceof File)) throw new Error(`Missing attachment${index}`);
      const uploaded = await base44.asServiceRole.integrations.Core.UploadPrivateFile({ file });
      if (!uploaded?.file_uri) throw new Error(`Attachment${index} could not be stored`);
      attachments.push({ name: file.name, type: file.type, size: file.size, file_uri: uploaded.file_uri });
    }
    const reference = header(headers, "In-Reply-To") || header(headers, "References").split(/\s+/).pop() || "";
    let conversation = null;
    if (reference) {
      const linked = await base44.asServiceRole.entities.SharedEmailMessage.filter({ provider_message_id: reference.replace(/[<>]/g, "") });
      if (linked[0]) conversation = (await base44.asServiceRole.entities.SharedEmailConversation.filter({ id: linked[0].conversation_id }))[0];
    }
    if (!conversation) {
      const normalizedSubject = subject.replace(/^(re|fwd):\s*/i, "");
      const candidates = await base44.asServiceRole.entities.SharedEmailConversation.filter({ alias_id: alias.id }, "-last_message_at", 50);
      conversation = candidates.find((item: any) => String(item.subject || "").replace(/^(re|fwd):\s*/i, "") === normalizedSubject && (item.participants || []).includes(from));
    }
    if (!conversation) {
      conversation = await base44.asServiceRole.entities.SharedEmailConversation.create({
        alias_id: alias.id, subject, participants: [from], preview: textBody.slice(0, 180),
        folder: "inbox", last_message_at: receivedAt, unread_count: 1,
      });
    } else {
      await base44.asServiceRole.entities.SharedEmailConversation.update(conversation.id, {
        participants: [...new Set([...(conversation.participants || []), from])],
        preview: textBody.slice(0, 180), folder: "inbox", last_message_at: receivedAt,
        unread_count: Number(conversation.unread_count || 0) + 1,
      });
    }
    const message = await base44.asServiceRole.entities.SharedEmailMessage.create({
      conversation_id: conversation.id, alias_id: alias.id, direction: "inbound", from_address: from,
      to_addresses: recipients, cc_addresses: splitAddresses(form.get("cc")), subject, text_body: textBody,
      html_body: htmlBody, provider_message_id: providerMessageId,
      delivery_status: "received", sent_at: receivedAt, attachments,
    });
    await base44.asServiceRole.entities.SharedEmailLog.create({ action: "receive", alias_id: alias.id, message_id: message.id, success: true, details: { from } });
    return Response.json({ accepted: true });
  } catch (error) {
    console.error("sharedEmailSendgridInbound", error);
    return Response.json({ error: error instanceof Error ? error.message : String(error) }, { status: 500 });
  }
});
