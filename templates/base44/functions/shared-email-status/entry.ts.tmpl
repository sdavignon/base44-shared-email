import { createClientFromRequest } from "npm:@base44/sdk";
import { SHARED_EMAIL } from "../../shared/sharedEmailConfig.ts";
import { sharedEmailAccess } from "../../shared/sharedEmailPermissions.ts";

Deno.serve(async (request) => {
  try {
    const base44 = createClientFromRequest(request);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: "Authentication required" }, { status: 401 });
    const access = await sharedEmailAccess(base44, user);
    const settings = access.isAdmin ? (await base44.asServiceRole.entities.SharedEmailSettings.filter({ key: "default" }))[0] : null;
    return Response.json({
      ok: true,
      package: SHARED_EMAIL.package,
      version: SHARED_EMAIL.version,
      builtBy: SHARED_EMAIL.builtBy,
      brandName: SHARED_EMAIL.brandName,
      domain: SHARED_EMAIL.domain,
      aliases: access.aliases.length,
      provider: settings?.provider || null,
      hasProviderSecret: access.isAdmin ? Boolean(Deno.env.get(settings?.provider === "resend" ? "RESEND_API_KEY" : "SENDGRID_API_KEY")) : undefined,
    });
  } catch (error) {
    return Response.json({ ok: false, error: error instanceof Error ? error.message : String(error) }, { status: 500 });
  }
});
